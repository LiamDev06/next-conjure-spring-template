# Pin installed versions exactly.
save-exact=true
save-prefix=""

# 7-day cooldown on newly published versions (pnpm >= 10.16).
minimum-release-age=10080

# Block lifecycle scripts from dependencies (supply-chain hardening).
ignore-scripts=true

# eslint-plugin-react-hooks@7.x peer range stops at eslint@^9 but works on 10.
strict-peer-dependencies=false
